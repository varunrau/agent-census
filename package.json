  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varunrau/agent-census.git"
  },
  "homepage": "https://github.com/varunrau/agent-census",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}

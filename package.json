{
  "name": "agent-census",
  "version": "0.1.0",
  "description": "📊 AI agent observability — trace sessions, tokens, and outcomes. The only tool that tracks what your agents actually built.",
  "type": "module",
  "bin": {
    "agent-census": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "codex",
    "token-usage",
    "observability",
    "outcome-tracking",
    "developer-tools"
  ],
